{
  "schema_version": "1.0",
  "activation_policy_ref": "local://synthetic-m4/activation-policy.json",
  "counterfactual_policy_ref": "local://synthetic-m4c/counterfactual-execution-policy.json",
  "auto_activation_enabled": true,
  "risk_signal_order": [
    "BASELINE_CLARIFY",
    "MISSING_REQUIRED_CONTEXT",
    "AMBIGUOUS_ACRONYM",
    "APPROVAL_REQUIRED",
    "TECHNICAL_FAILURE",
    "UNSUPPORTED_MODALITY",
    "UNRESOLVED_REQUIRED_REFERENCE",
    "CONTRADICTORY_SOURCES",
    "SCOPE_SENSITIVE",
    "JURISDICTION_SENSITIVE",
    "SERVICE_MODEL_SENSITIVE",
    "SOLICITATION_SENSITIVE",
    "WORKFLOW_STAGE_SENSITIVE",
    "COUNTERFACTUAL_REQUIRED",
    "CRITICAL_CONTROL_RISK",
    "TABLE_DEPENDENT",
    "REQUIRED_REFERENCE",
    "MULTI_PART_QUERY",
    "LOW_RETRIEVAL_MARGIN",
    "PROMPT_INJECTION_SIGNAL"
  ],
  "risk_signal_rules": [
    {"signal": "BASELINE_CLARIFY", "source": "baseline.decision", "rule": "decision == CLARIFY"},
    {"signal": "MISSING_REQUIRED_CONTEXT", "source": "baseline.reason_codes", "rule": "reason contains MISSING_REQUIRED_CONTEXT"},
    {"signal": "AMBIGUOUS_ACRONYM", "source": "baseline.reason_codes", "rule": "reason contains AMBIGUOUS_ACRONYM"},
    {"signal": "APPROVAL_REQUIRED", "source": "baseline.reason_codes", "rule": "reason contains APPROVAL_REQUIRED"},
    {"signal": "TECHNICAL_FAILURE", "source": "baseline.reason_codes", "rule": "reason contains TECHNICAL_FAILURE"},
    {"signal": "UNSUPPORTED_MODALITY", "source": "baseline.reason_codes", "rule": "reason contains UNSUPPORTED_MODALITY"},
    {"signal": "UNRESOLVED_REQUIRED_REFERENCE", "source": "baseline.reason_codes", "rule": "reason contains UNRESOLVED_REQUIRED_REFERENCE"},
    {"signal": "CONTRADICTORY_SOURCES", "source": "verification_and_retrieval", "rule": "material sources disagree"},
    {"signal": "SCOPE_SENSITIVE", "source": "structured_context_and_evidence", "rule": "region context and explicit region scope"},
    {"signal": "JURISDICTION_SENSITIVE", "source": "structured_context_and_evidence", "rule": "jurisdiction context and explicit jurisdiction scope"},
    {"signal": "SERVICE_MODEL_SENSITIVE", "source": "structured_context_and_evidence", "rule": "service_model context and explicit service scope"},
    {"signal": "SOLICITATION_SENSITIVE", "source": "structured_context_and_plan", "rule": "solicitation_type supplied or required"},
    {"signal": "WORKFLOW_STAGE_SENSITIVE", "source": "structured_context_and_plan", "rule": "workflow_stage supplied or required"},
    {"signal": "COUNTERFACTUAL_REQUIRED", "source": "runtime_policy", "rule": "answer plus implemented scope or service dimension"},
    {"signal": "CRITICAL_CONTROL_RISK", "source": "claims_and_verification", "rule": "critical claim exists"},
    {"signal": "TABLE_DEPENDENT", "source": "query_plan_and_evidence", "rule": "configuration lookup or table-row evidence"},
    {"signal": "REQUIRED_REFERENCE", "source": "verification", "rule": "required reference is declared"},
    {"signal": "MULTI_PART_QUERY", "source": "query_plan", "rule": "subquery count greater than one"},
    {"signal": "LOW_RETRIEVAL_MARGIN", "source": "retrieval_diagnostics", "rule": "top-two fused margin below threshold"},
    {"signal": "PROMPT_INJECTION_SIGNAL", "source": "source_safety", "rule": "diagnostic code SOURCE_INSTRUCTION_IGNORED"}
  ],
  "execution_budget": {
    "maximum_total_worker_tasks": 7,
    "maximum_worker_depth": 1,
    "maximum_parallel_discovery_workers": 3,
    "maximum_challenge_rounds": 1,
    "maximum_counterfactual_variants": 3,
    "maximum_counterfactual_depth": 1
  }
}
